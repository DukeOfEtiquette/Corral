# Environment variables for the api service.
# Copy to .env and fill in real values. Never commit .env.
# Generate ADMIN_PASSWORD_HASH locally with argon2-cffi (ADR-006, ADR-011):
#   python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('your-password'))"

DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Optional overrides (defaults shown):
# SESSION_COOKIE_NAME=session
# SESSION_LIFETIME_SECONDS=604800
# SESSION_COOKIE_SECURE=false
