# Secrets: admin bootstrap credentials live in .env, never in source (ADR-006)
.env
.env.*
!.env.example

# Scratch artifacts: status snapshots, intermediate analyses (ADR-023, ADR-024).
# Kickoffs and worker reports are tracked in .claude/artifacts/handoffs/ (ADR-024).
.claude/artifacts/tmp/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node / frontend (lands in a later phase)
node_modules/
dist/

# Editor / OS
.DS_Store
